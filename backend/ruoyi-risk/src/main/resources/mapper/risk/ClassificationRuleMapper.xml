<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.risk.mapper.ClassificationRuleMapper">
    <resultMap type="com.ruoyi.risk.domain.ClassificationRule" id="ClassificationRuleResult">
        <result property="ruleId" column="rule_id"/>
        <result property="ruleName" column="rule_name"/>
        <result property="ruleType" column="rule_type"/>
        <result property="fiveLevel" column="five_level"/>
        <result property="priority" column="priority"/>
        <result property="conditionJson" column="condition_json"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectById" parameterType="Long" resultMap="ClassificationRuleResult">
        SELECT * FROM classification_rule WHERE rule_id = #{ruleId}
    </select>

    <select id="selectList" parameterType="com.ruoyi.risk.domain.ClassificationRule" resultMap="ClassificationRuleResult">
        SELECT * FROM classification_rule
        <where>
            <if test="ruleName != null and ruleName != ''">AND rule_name LIKE concat('%', #{ruleName}, '%')</if>
            <if test="ruleType != null and ruleType != ''">AND rule_type = #{ruleType}</if>
            <if test="fiveLevel != null and fiveLevel != ''">AND five_level = #{fiveLevel}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY priority DESC
    </select>

    <select id="selectEnabled" resultMap="ClassificationRuleResult">
        SELECT * FROM classification_rule WHERE status = '1' ORDER BY priority DESC
    </select>

    <insert id="insert" parameterType="com.ruoyi.risk.domain.ClassificationRule" useGeneratedKeys="true" keyProperty="ruleId">
        INSERT INTO classification_rule (rule_name, rule_type, five_level, priority, condition_json, description, status)
        VALUES (#{ruleName}, #{ruleType}, #{fiveLevel}, #{priority}, #{conditionJson}, #{description}, #{status})
    </insert>

    <update id="update" parameterType="com.ruoyi.risk.domain.ClassificationRule">
        UPDATE classification_rule
        <set>
            <if test="ruleName != null">rule_name = #{ruleName},</if>
            <if test="ruleType != null">rule_type = #{ruleType},</if>
            <if test="fiveLevel != null">five_level = #{fiveLevel},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="conditionJson != null">condition_json = #{conditionJson},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE rule_id = #{ruleId}
    </update>

    <delete id="deleteByIds" parameterType="String">
        DELETE FROM classification_rule WHERE rule_id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
