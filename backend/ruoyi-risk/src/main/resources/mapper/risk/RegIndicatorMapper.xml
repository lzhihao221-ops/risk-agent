<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.risk.mapper.RegIndicatorMapper">
    <resultMap type="com.ruoyi.risk.domain.RegIndicator" id="RegIndicatorResult">
        <result property="id" column="id"/>
        <result property="indicatorCode" column="indicator_code"/>
        <result property="indicatorName" column="indicator_name"/>
        <result property="indicatorType" column="indicator_type"/>
        <result property="calcDate" column="calc_date"/>
        <result property="reportPeriod" column="report_period"/>
        <result property="indicatorValue" column="indicator_value"/>
        <result property="unit" column="unit"/>
        <result property="thresholdWarn" column="threshold_warn"/>
        <result property="thresholdDanger" column="threshold_danger"/>
        <result property="regulatoryLine" column="regulatory_line"/>
        <result property="status" column="status"/>
        <result property="calcDetail" column="calc_detail"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectById" parameterType="Long" resultMap="RegIndicatorResult">
        select * from reg_indicator where id = #{id}
    </select>

    <select id="selectList" parameterType="com.ruoyi.risk.domain.RegIndicator" resultMap="RegIndicatorResult">
        select * from reg_indicator
        <where>
            <if test="indicatorCode != null and indicatorCode != ''">and indicator_code = #{indicatorCode}</if>
            <if test="indicatorType != null and indicatorType != ''">and indicator_type = #{indicatorType}</if>
            <if test="reportPeriod != null and reportPeriod != ''">and report_period = #{reportPeriod}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by indicator_type, indicator_code
    </select>

    <select id="selectByType" parameterType="String" resultMap="RegIndicatorResult">
        select * from reg_indicator where indicator_type = #{indicatorType} order by indicator_code
    </select>

    <insert id="insert" parameterType="com.ruoyi.risk.domain.RegIndicator" useGeneratedKeys="true" keyProperty="id">
        insert into reg_indicator (indicator_code, indicator_name, indicator_type, calc_date, report_period, indicator_value, unit, threshold_warn, threshold_danger, regulatory_line, status, calc_detail, remark, create_by)
        values (#{indicatorCode}, #{indicatorName}, #{indicatorType}, #{calcDate}, #{reportPeriod}, #{indicatorValue}, #{unit}, #{thresholdWarn}, #{thresholdDanger}, #{regulatoryLine}, #{status}, #{calcDetail}, #{remark}, #{createBy})
    </insert>

    <update id="update" parameterType="com.ruoyi.risk.domain.RegIndicator">
        update reg_indicator
        <set>
            <if test="indicatorValue != null">indicator_value = #{indicatorValue},</if>
            <if test="status != null">status = #{status},</if>
            <if test="calcDetail != null">calc_detail = #{calcDetail},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteByIds" parameterType="String">
        delete from reg_indicator where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
