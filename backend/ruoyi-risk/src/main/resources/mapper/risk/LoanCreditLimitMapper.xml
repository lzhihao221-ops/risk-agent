<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.risk.mapper.LoanCreditLimitMapper">
    <resultMap type="com.ruoyi.risk.domain.LoanCreditLimit" id="CreditLimitResult">
        <result property="id" column="id"/>
        <result property="companyId" column="company_id"/>
        <result property="companyName" column="company_name"/>
        <result property="totalLimit" column="total_limit"/>
        <result property="usedLimit" column="used_limit"/>
        <result property="availableLimit" column="available_limit"/>
        <result property="creditGrade" column="credit_grade"/>
        <result property="validFrom" column="valid_from"/>
        <result property="validTo" column="valid_to"/>
        <result property="reviewDate" column="review_date"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectById" parameterType="Long" resultMap="CreditLimitResult">
        SELECT * FROM loan_credit_limit WHERE id = #{id}
    </select>

    <select id="selectByCompanyId" parameterType="Long" resultMap="CreditLimitResult">
        SELECT * FROM loan_credit_limit WHERE company_id = #{companyId}
    </select>

    <select id="selectList" parameterType="com.ruoyi.risk.domain.LoanCreditLimit" resultMap="CreditLimitResult">
        SELECT * FROM loan_credit_limit
        <where>
            <if test="companyName != null and companyName != ''">
                AND company_name LIKE CONCAT('%', #{companyName}, '%')
            </if>
            <if test="creditGrade != null and creditGrade != ''">
                AND credit_grade = #{creditGrade}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.ruoyi.risk.domain.LoanCreditLimit" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO loan_credit_limit (company_id, company_name, total_limit, used_limit, available_limit,
            credit_grade, valid_from, valid_to, review_date, status, remark, create_by)
        VALUES (#{companyId}, #{companyName}, #{totalLimit}, #{usedLimit}, #{availableLimit},
            #{creditGrade}, #{validFrom}, #{validTo}, #{reviewDate}, #{status}, #{remark}, #{createBy})
    </insert>

    <update id="update" parameterType="com.ruoyi.risk.domain.LoanCreditLimit">
        UPDATE loan_credit_limit
        <set>
            <if test="companyName != null">company_name = #{companyName},</if>
            <if test="totalLimit != null">total_limit = #{totalLimit},</if>
            <if test="usedLimit != null">used_limit = #{usedLimit},</if>
            <if test="availableLimit != null">available_limit = #{availableLimit},</if>
            <if test="creditGrade != null">credit_grade = #{creditGrade},</if>
            <if test="validFrom != null">valid_from = #{validFrom},</if>
            <if test="validTo != null">valid_to = #{validTo},</if>
            <if test="reviewDate != null">review_date = #{reviewDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteByIds">
        DELETE FROM loan_credit_limit WHERE id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
