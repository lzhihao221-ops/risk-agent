<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.risk.mapper.PdModelMapper">
    <resultMap type="com.ruoyi.risk.domain.PdModel" id="PdModelResult">
        <result property="modelId" column="model_id"/>
        <result property="modelName" column="model_name"/>
        <result property="modelType" column="model_type"/>
        <result property="modelVersion" column="model_version"/>
        <result property="targetVariable" column="target_variable"/>
        <result property="sampleSize" column="sample_size"/>
        <result property="aucRoc" column="auc_roc"/>
        <result property="ksStatistic" column="ks_statistic"/>
        <result property="gini" column="gini"/>
        <result property="trainingDate" column="training_date"/>
        <result property="cutoffScore" column="cutoff_score"/>
        <result property="coefficientJson" column="coefficient_json"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectById" parameterType="Long" resultMap="PdModelResult">
        SELECT * FROM pd_model WHERE model_id = #{modelId}
    </select>

    <select id="selectList" parameterType="com.ruoyi.risk.domain.PdModel" resultMap="PdModelResult">
        SELECT * FROM pd_model
        <where>
            <if test="modelName != null and modelName != ''">AND model_name LIKE concat('%', #{modelName}, '%')</if>
            <if test="modelType != null and modelType != ''">AND model_type = #{modelType}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectEnabled" resultMap="PdModelResult">
        SELECT * FROM pd_model WHERE status = '1' ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.ruoyi.risk.domain.PdModel" useGeneratedKeys="true" keyProperty="modelId">
        INSERT INTO pd_model (model_name, model_type, model_version, target_variable, sample_size, auc_roc, ks_statistic, gini, training_date, cutoff_score, coefficient_json, status, remark)
        VALUES (#{modelName}, #{modelType}, #{modelVersion}, #{targetVariable}, #{sampleSize}, #{aucRoc}, #{ksStatistic}, #{gini}, #{trainingDate}, #{cutoffScore}, #{coefficientJson}, #{status}, #{remark})
    </insert>

    <update id="update" parameterType="com.ruoyi.risk.domain.PdModel">
        UPDATE pd_model
        <set>
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="modelType != null">model_type = #{modelType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="coefficientJson != null">coefficient_json = #{coefficientJson},</if>
        </set>
        WHERE model_id = #{modelId}
    </update>

    <delete id="deleteByIds" parameterType="String">
        DELETE FROM pd_model WHERE model_id IN
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
