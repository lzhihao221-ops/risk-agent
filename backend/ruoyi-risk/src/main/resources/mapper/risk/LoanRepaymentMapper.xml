<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.risk.mapper.LoanRepaymentMapper">
    <resultMap type="com.ruoyi.risk.domain.LoanRepayment" id="RepayResult">
        <result property="id" column="id"/><result property="loanId" column="loan_id"/><result property="loanNo" column="loan_no"/>
        <result property="periodNo" column="period_no"/><result property="planDate" column="plan_date"/>
        <result property="planPrincipal" column="plan_principal"/><result property="planInterest" column="plan_interest"/>
        <result property="planTotal" column="plan_total"/><result property="actualDate" column="actual_date"/>
        <result property="actualPrincipal" column="actual_principal"/><result property="actualInterest" column="actual_interest"/>
        <result property="actualTotal" column="actual_total"/><result property="status" column="status"/>
        <result property="overdueDays" column="overdue_days"/>
    </resultMap>
    <select id="selectByLoanId" parameterType="Long" resultMap="RepayResult">SELECT * FROM loan_repayment WHERE loan_id=#{loanId} ORDER BY period_no</select>
    <insert id="insert" parameterType="com.ruoyi.risk.domain.LoanRepayment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO loan_repayment (loan_id,loan_no,period_no,plan_date,plan_principal,plan_interest,plan_total,status) VALUES (#{loanId},#{loanNo},#{periodNo},#{planDate},#{planPrincipal},#{planInterest},#{planTotal},#{status})
    </insert>
    <update id="updateStatus" parameterType="com.ruoyi.risk.domain.LoanRepayment">
        UPDATE loan_repayment SET status=#{status}<if test="actualDate!=null">, actual_date=#{actualDate}</if><if test="actualPrincipal!=null">, actual_principal=#{actualPrincipal}</if><if test="actualInterest!=null">, actual_interest=#{actualInterest}</if><if test="actualTotal!=null">, actual_total=#{actualTotal}</if><if test="overdueDays!=null">, overdue_days=#{overdueDays}</if> WHERE id=#{id}
    </update>
</mapper>
